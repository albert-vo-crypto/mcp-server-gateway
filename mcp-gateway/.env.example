# Generate with: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=

# JFrog Artifactory settings (used by the artifactory-mcp container)
ARTIFACTORY_BASE_URL=https://your-instance.jfrog.io/artifactory

# Preferred auth: a JFrog access/identity token used as a Bearer credential.
# Works with a company-issued access token AND a free-tier identity token
# (JFrog Platform UI -> Profile -> Generate an Identity Token).
ARTIFACTORY_ACCESS_TOKEN=

# Legacy fallback only (deprecated, older self-hosted API keys). Leave blank
# if you are using ARTIFACTORY_ACCESS_TOKEN above.
# ARTIFACTORY_API_KEY=

# Google Drive + Docs settings (used by the gdrive-mcp container)
# Secure mode (recommended): forward each user's Google access token. Requires
# the Google OAuth client below and the secure-* config files.
# GDRIVE_SECURE_MODE=true
# Open mode alternatives (shared credential, no per-user OAuth):
# GOOGLE_ACCESS_TOKEN=
# GOOGLE_SERVICE_ACCOUNT_FILE=
# GOOGLE_IMPERSONATE_SUBJECT=

# Google OAuth client (secure mode; also used by the google-drive provider).
# The client must have the Drive + Docs scopes enabled.
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
